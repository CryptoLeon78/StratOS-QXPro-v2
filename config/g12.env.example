# Generado localmente por scripts/create_g12_env.py; no versionar .env.g12.
POSTGRES_DB=stratos_g12
POSTGRES_USER=stratos_g12_user
POSTGRES_PASSWORD=replace-with-generated-secret
APP_DB_PASSWORD=replace-with-generated-secret
DATABASE_URL=postgresql+asyncpg://stratos_g12_user:replace-with-generated-secret@localhost:56432/stratos_g12
APP_DATABASE_URL=postgresql+asyncpg://stratos_app:replace-with-generated-secret@localhost:56432/stratos_g12
REDIS_URL=redis://localhost:6480/0

# Conservados desde el entorno local existente por el generador, nunca incluir secretos aquí.
JWT_SECRET=replace-from-local-env
INGEST_API_KEYS=replace-with-g12-key
OPERATOR_EMAIL=operador@example.com
OPERATOR_PASSWORD_HASH=replace-from-local-env
CORS_ALLOWED_ORIGINS=http://localhost:5373

G12_POSTGRES_PORT=56432
G12_REDIS_PORT=6480
G12_CORE_PORT=8200
G12_GATEWAY_PORT=8280
G12_FRONTEND_PORT=5373
