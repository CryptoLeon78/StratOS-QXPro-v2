# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
output/playwright/
.playwright-cli/

# Env / secrets
.env
.env.*
!.env.example
# Las plantillas *.example son las unicas versionadas (phase_status G13): la regla
# `.env.*` de arriba tambien las capturaba, asi que se desexcluyen explicitamente.
!.env.*.example

# Docker / infra local state
postgres-data/
redis-data/

# Backups (G9, scripts/backup_postgres.sh) -- dumps de datos reales/
# sinteticos densos, nunca al repo (BACKUP_DIR por defecto).
backups/
*.dump

# Runtime evidence / secrets of the isolated G12 demo campaign.
runtime/
dist/

# Historico de deals de cuentas Darwinex REALES exportado por StratOSHistoryExport.mq5.
# Es evidencia operativa voluminosa (9.082 deals con precio, volumen y profit), no
# documentacion: su sitio es runtime/operational/history/, ignorado como el resto de
# la evidencia. Se ignora tambien en docs/ mientras la ingesta los lea de ahi.
docs/history_deals_*.csv

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs generated
docs/screenshots/*.png
docs/screenshots/*.diff.png

# Robocorp/RCC quedo instalado dentro de .github/workflows: 66 MB de binarios
# (bin/, micromamba/) mas sus cachés y journals. Ahi solo deben vivir los
# workflows de GitHub Actions -- Actions intenta interpretar como workflow todo
# .yml/.yaml de esa carpeta, asi que rcc.yaml y rcccache.yaml tampoco pintan
# nada. Se listan uno a uno a proposito: una regla amplia sobre este directorio
# acabaria escondiendo un workflow de verdad.
.github/workflows/bin/
.github/workflows/micromamba/
.github/workflows/temp/
.github/workflows/hololib/
.github/workflows/journals/
.github/workflows/pipcache/
.github/workflows/pkgs/
.github/workflows/robots/
.github/workflows/rcc.yaml
.github/workflows/rcccache.yaml
.github/workflows/*.lck
