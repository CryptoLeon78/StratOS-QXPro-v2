# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
output/playwright/
.playwright-cli/

# Env / secrets
.env
.env.*
!.env.example
# Las plantillas *.example son las unicas versionadas (phase_status G13): la regla
# `.env.*` de arriba tambien las capturaba, asi que se desexcluyen explicitamente.
!.env.*.example

# Docker / infra local state
postgres-data/
redis-data/

# Backups (G9, scripts/backup_postgres.sh) -- dumps de datos reales/
# sinteticos densos, nunca al repo (BACKUP_DIR por defecto).
backups/
*.dump

# Runtime evidence / secrets of the isolated G12 demo campaign.
runtime/
dist/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs generated
docs/screenshots/*.png
docs/screenshots/*.diff.png

# Red de seguridad, no una instalacion escondida: RCC llego a instalarse dentro
# de .github/workflows (65 MB de uv y micromamba mas sus caches). El 2026-09-26
# se movio a %LOCALAPPDATA%obocorp y se fijo ROBOCORP_HOME (User) apuntando
# ahi. Ya paso una vez antes -- se borro y volvio (ASSUMPTIONS, hallazgo
# transversal de G10) --, asi que estas reglas se quedan por si reincide.
# Actions interpreta como workflow todo .yml/.yaml de esa carpeta, de modo que
# rcc.yaml y rcccache.yaml tampoco pintan nada ahi. Se listan uno a uno a
# proposito: una regla amplia sobre este directorio acabaria escondiendo un
# workflow de verdad.
.github/workflows/bin/
.github/workflows/micromamba/
.github/workflows/temp/
.github/workflows/templates/
.github/workflows/uvcache/
.github/workflows/wheels/
.github/workflows/hololib/
.github/workflows/journals/
.github/workflows/pipcache/
.github/workflows/pkgs/
.github/workflows/robots/
.github/workflows/rcc.yaml
.github/workflows/rcccache.yaml
.github/workflows/*.lck

# Notas de credenciales en claro dentro del arbol de trabajo. Aparecio
# "contrasenas acceso produccion.txt" sin rastrear (7-sep, nunca commiteado).
# El patron es amplio a proposito: un fichero asi no debe poder colarse por
# llamarse de otra manera.
*contrase*a*.txt
*contrase*as*.md
*password*.txt
*credenciales*.txt
*secrets*.txt
