# mt5-connector: deployable propio (Nodo A, VPS Windows, PARTE 3).
# NUNCA junto al .env de la raiz del repo -- este servicio se instala solo
# en el VPS Windows, sin el resto del monorepo necesariamente presente.

CONNECTOR_CORE_ENGINE_URL=https://core.stratos-qxpro.example.com
CONNECTOR_INGEST_API_KEY=change-me
CONNECTOR_ACCOUNT_LOGIN=100231

# Cadencias (PARTE 12): positions/equity/heartbeat son contractuales;
# deals_poll_interval_s es asuncion propia (ver ASSUMPTIONS G4).
CONNECTOR_POSITIONS_POLL_INTERVAL_S=5.0
CONNECTOR_DEALS_POLL_INTERVAL_S=5.0
CONNECTOR_EQUITY_POLL_INTERVAL_S=30.0
CONNECTOR_HEARTBEAT_INTERVAL_S=60.0

# Backoff exponencial (solo el cap de 5 min es contractual, PARTE 12).
CONNECTOR_BACKOFF_BASE_SECONDS=5.0
CONNECTOR_BACKOFF_MULTIPLIER=2.0
CONNECTOR_BACKOFF_MAX_SECONDS=300.0

CONNECTOR_BUFFER_DB_PATH=C:\ProgramData\StratOSQXPro\mt5-connector\buffer.sqlite
CONNECTOR_MT5_TERMINAL_PATH=
