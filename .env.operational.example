# Crear .env.operational localmente; nunca copiar secretos desde G12.
POSTGRES_DB=stratos_operational
POSTGRES_USER=stratos_user
POSTGRES_PASSWORD=replace-me
APP_DB_PASSWORD=replace-me
JWT_SECRET=replace-me
INGEST_API_KEYS=replace-me
REDIS_URL=redis://redis:6379/0
DEPLOYMENT_PROFILE=operational
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5473
OPERATOR_EMAIL=
OPERATOR_PASSWORD_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Chat PRIVADO del operador con el bot (nunca un grupo/canal de alertas: un ID
# de grupo/canal empieza por "-100"). Incidente real 2026-09-26: se pego aqui
# uno de los IDs de TELEGRAM_CHAT_IDS y el codigo de recuperacion llegaba al
# grupo de alertas en vez de al operador -- ver ASSUMPTIONS.md G13-65.
TELEGRAM_RECOVERY_CHAT_ID=
