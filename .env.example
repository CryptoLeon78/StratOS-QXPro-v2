# Bootstrap del contenedor postgres (docker-compose). core-engine construye
# DATABASE_URL a partir de estas mismas variables (ver docker-compose.yml)
# para que no haya dos fuentes de la misma credencial.
POSTGRES_DB=stratos
POSTGRES_USER=stratos_user
POSTGRES_PASSWORD=change-me

# --- Settings de core-engine / api-gateway (PARTE 10.1) ---
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
INGEST_API_KEYS=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
DEPLOYMENT_PROFILE=full
TZ_DISPLAY=Europe/Madrid
BASE_CURRENCY=EUR
NEWS_PROVIDER=ics
NEWS_SOURCE_URL=
BENCHMARK_PROVIDER=csv
BENCHMARK_SYMBOL=^SPX
OPERATOR_EMAIL=operador@example.com
OPERATOR_PASSWORD_HASH=change-me
