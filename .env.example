# Bootstrap del contenedor postgres (docker-compose). Dentro de docker-compose,
# core-engine/worker/scheduler reciben DATABASE_URL ya construido a partir de
# estas mismas variables (ver docker-compose.yml) para que no haya dos fuentes
# de la misma credencial. Fuera de docker (Alembic/pytest corridos directo en
# el venv), usa DATABASE_URL/APP_DATABASE_URL de abajo (puerto de host 55432,
# ver ASSUMPTIONS G0-13).
POSTGRES_DB=stratos
POSTGRES_USER=stratos_user
POSTGRES_PASSWORD=change-me

# Rol de aplicacion (G1, PARTE 12): SELECT/INSERT/UPDATE/DELETE en tablas
# mutables, solo SELECT/INSERT en las 6 inmutables (P6). Lo crea la migracion
# 0001 usando esta password; nunca literal en el codigo de la migracion.
APP_DB_PASSWORD=change-me

# Para ejecutar Alembic/pytest fuera de docker-compose (venv local):
DATABASE_URL=postgresql+asyncpg://stratos_user:change-me@localhost:55432/stratos
APP_DATABASE_URL=postgresql+asyncpg://stratos_app:change-me@localhost:55432/stratos
REDIS_URL=redis://localhost:6380/0

# Pool por proceso (core-engine, worker, scheduler tienen CADA UNO su propio
# engine/pool). Default 20+20 esta pensado para un unico proceso; con varios
# procesos (varios --workers de uvicorn, mas worker+scheduler) la suma puede
# superar max_connections de Postgres -- ver docker-compose.operational.yml,
# donde se bajan a 5+5 por proceso. Hallazgo real, 2026-09-28.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# --- Settings de core-engine / api-gateway (PARTE 10.1) ---
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
INGEST_API_KEYS=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional comma-separated group or user IDs. When set, it replaces
# TELEGRAM_CHAT_ID and each alert is delivered to every listed destination.
TELEGRAM_CHAT_IDS=
# Chat privado del operador para codigos de recuperacion; nunca usar grupos.
TELEGRAM_RECOVERY_CHAT_ID=
# Politica de recuperacion. Los valores de ejemplo se pueden ajustar por entorno.
AUTH_RECOVERY_CODE_TTL_S=600
AUTH_RECOVERY_CODE_LENGTH=6
AUTH_RECOVERY_MAX_ATTEMPTS=5
AUTH_RECOVERY_REQUEST_COOLDOWN_S=60
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_RECOVERY_TELEGRAM_TEMPLATE=StratOS: tu codigo de recuperacion es {code}. Caduca en {minutes} min.
SENTRY_DSN=
DEPLOYMENT_PROFILE=full
TZ_DISPLAY=Europe/Madrid
BASE_CURRENCY=EUR
NEWS_PROVIDER=ics
NEWS_SOURCE_URL=
BENCHMARK_PROVIDER=csv
BENCHMARK_SYMBOL=^SPX
# G10: opcional -- SIN DEFINIR (no "=" vacio, un Path vacio apuntaria al cwd)
# resuelve contra la raiz del repo (scripts/data/sp500_monthly.csv). Descomentar
# solo para apuntar a otro fichero:
# BENCHMARK_CSV_PATH=/ruta/a/otro/sp500_monthly.csv
OPERATOR_EMAIL=operador@example.com
OPERATOR_PASSWORD_HASH=change-me

# G6: origenes permitidos por CORS para que el frontend (dev server de Vite)
# pueda llamar a core-engine directo. Coma-separado si hace falta mas de uno.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Settings de api-gateway (G9, PARTE 3/12): proxy transparente + rate
# limit + WS broker hacia core-engine. Sin JWT_SECRET propio -- nunca valida
# el token, solo lo reenvia (core-engine sigue siendo la unica fuente de
# verdad de auth).
CORE_ENGINE_URL=http://localhost:8100
CORE_ENGINE_WS_URL=ws://localhost:8100
RATE_LIMIT_PER_MINUTE=120

# --- Backups (G9, PARTE 14): scripts/backup_postgres.sh ---
BACKUP_RETENTION_DAYS=14
