# Bootstrap del contenedor postgres (docker-compose). Dentro de docker-compose,
# core-engine/worker/scheduler reciben DATABASE_URL ya construido a partir de
# estas mismas variables (ver docker-compose.yml) para que no haya dos fuentes
# de la misma credencial. Fuera de docker (Alembic/pytest corridos directo en
# el venv), usa DATABASE_URL/APP_DATABASE_URL de abajo (puerto de host 55432,
# ver ASSUMPTIONS G0-13).
POSTGRES_DB=stratos
POSTGRES_USER=stratos_user
POSTGRES_PASSWORD=change-me

# Rol de aplicacion (G1, PARTE 12): SELECT/INSERT/UPDATE/DELETE en tablas
# mutables, solo SELECT/INSERT en las 6 inmutables (P6). Lo crea la migracion
# 0001 usando esta password; nunca literal en el codigo de la migracion.
APP_DB_PASSWORD=change-me

# Para ejecutar Alembic/pytest fuera de docker-compose (venv local):
DATABASE_URL=postgresql+asyncpg://stratos_user:change-me@localhost:55432/stratos
APP_DATABASE_URL=postgresql+asyncpg://stratos_app:change-me@localhost:55432/stratos
REDIS_URL=redis://localhost:6380/0

# --- Settings de core-engine / api-gateway (PARTE 10.1) ---
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
INGEST_API_KEYS=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
DEPLOYMENT_PROFILE=full
TZ_DISPLAY=Europe/Madrid
BASE_CURRENCY=EUR
NEWS_PROVIDER=ics
NEWS_SOURCE_URL=
BENCHMARK_PROVIDER=csv
BENCHMARK_SYMBOL=^SPX
OPERATOR_EMAIL=operador@example.com
OPERATOR_PASSWORD_HASH=change-me
