{
  "$comment": "Guardar como .claude\\settings.json en C:\\BOTS\\SCRIPTS\\StratOS-QXPro. Capa MECANICA de las instrucciones de comportamiento: lo que las reglas dicen, esto lo impone. Requiere scripts\\guardrails\\pre_commit_scan.py (entregado junto a este archivo).",
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(alembic:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(Remove-Item -Recurse -Force:*)",
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Edit(./doc_app/**)",
      "Write(./doc_app/**)",
      "Edit(./capturas_proyecto_dashboard/**)",
      "Write(./capturas_proyecto_dashboard/**)",
      "Edit(./core-engine/alembic/versions/*.py)",
      "Bash(alembic downgrade:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo [StratOS] Antes de trabajar: lee CLAUDE.md, docs\\phase_status.md y ASSUMPTIONS.md. Prompt maestro: doc_app\\PROMPT_MAESTRO.md. Regla P11: cero hardcoding."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts\\guardrails\\pre_commit_scan.py"
          }
        ]
      }
    ]
  }
}
